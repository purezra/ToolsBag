{
  "name": "toolsbag",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "typecheck": "vue-tsc -b config/tsconfig.json",
    "build": "vue-tsc -b config/tsconfig.json && vite build --config config/vite.config.ts",
    "test": "npm run test:unit && npm run build && npm run test:navigation",
    "test:unit": "node --experimental-strip-types --test tests/file-traverse-patterns.spec.mjs tests/media-batch-filter.spec.mjs tests/media-view-switch.spec.mjs",
    "test:navigation": "node --test tests/tool-navigation.spec.mjs",
    "preview": "vite preview --config config/vite.config.ts",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "vue-tsc -b config/tsconfig.json && cargo check --manifest-path src-tauri/Cargo.toml",
    "quality": "vue-tsc -b config/tsconfig.json && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.8",
    "exceljs": "^4.4.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "playwright": "^1.61.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
